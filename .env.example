# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Dev bypass token (only used in DEV mode with admin@foxypromote.com / admin123XXX!)
VITE_DEV_TOKEN=dev-bypass-token

# PostHog Analytics
VITE_POSTHOG_API_KEY=phc_your_posthog_api_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_AUTH_TOKEN=sntrys_your_auth_token
